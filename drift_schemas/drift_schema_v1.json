          "sql": "CREATE TABLE IF NOT EXISTS \"scan_errors\" (\"path\" TEXT NOT NULL, \"message\" TEXT NOT NULL, \"at\" INTEGER NOT NULL, PRIMARY KEY (\"path\"));"
        }
      ]
