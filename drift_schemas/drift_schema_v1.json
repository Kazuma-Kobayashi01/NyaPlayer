  "fixed_sql": [
    {
      "name": "albums",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"albums\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"album_key\" TEXT NOT NULL UNIQUE, \"title\" TEXT NOT NULL DEFAULT '', \"album_artist\" TEXT NOT NULL DEFAULT '', \"year\" INTEGER NULL, \"cover_state\" INTEGER NOT NULL DEFAULT 0, \"cover_track_id\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "tracks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tracks\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"path\" TEXT NOT NULL UNIQUE, \"size\" INTEGER NOT NULL DEFAULT 0, \"mtime\" INTEGER NOT NULL DEFAULT 0, \"title\" TEXT NOT NULL DEFAULT '', \"artist\" TEXT NOT NULL DEFAULT '', \"album_artist\" TEXT NOT NULL DEFAULT '', \"album\" TEXT NOT NULL DEFAULT '', \"album_id\" INTEGER NULL REFERENCES albums (id) ON DELETE SET NULL, \"track_no\" INTEGER NULL, \"disc_no\" INTEGER NULL, \"year\" INTEGER NULL, \"genre\" TEXT NOT NULL DEFAULT '', \"duration_ms\" INTEGER NOT NULL DEFAULT 0, \"sample_rate\" INTEGER NULL, \"bit_depth\" INTEGER NULL, \"bitrate\" INTEGER NULL, \"channels\" INTEGER NULL, \"codec\" TEXT NOT NULL DEFAULT '', \"has_embedded_lyrics\" INTEGER NOT NULL DEFAULT 0 CHECK (\"has_embedded_lyrics\" IN (0, 1)), \"sidecar_lrc_path\" TEXT NULL, \"folder_cover_path\" TEXT NULL, \"metadata_error\" INTEGER NOT NULL DEFAULT 0 CHECK (\"metadata_error\" IN (0, 1)), \"added_at\" INTEGER NOT NULL DEFAULT 0, \"play_count\" INTEGER NOT NULL DEFAULT 0, \"last_played_at\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "artists",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"artists\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name_key\" TEXT NOT NULL UNIQUE, \"name\" TEXT NOT NULL);"
        }
      ]
    },
    {
      "name": "track_artists",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"track_artists\" (\"track_id\" INTEGER NOT NULL REFERENCES tracks (id) ON DELETE CASCADE, \"artist_id\" INTEGER NOT NULL REFERENCES artists (id) ON DELETE CASCADE, PRIMARY KEY (\"track_id\", \"artist_id\"));"
        }
      ]
    },
    {
      "name": "library_roots",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"library_roots\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"path\" TEXT NOT NULL UNIQUE, \"excluded\" INTEGER NOT NULL DEFAULT 0 CHECK (\"excluded\" IN (0, 1)));"
        }
      ]
    },
    {
      "name": "playlists",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"playlists\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "playlist_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"playlist_items\" (\"playlist_id\" INTEGER NOT NULL REFERENCES playlists (id) ON DELETE CASCADE, \"position\" INTEGER NOT NULL, \"track_id\" INTEGER NOT NULL REFERENCES tracks (id) ON DELETE CASCADE, PRIMARY KEY (\"playlist_id\", \"position\"));"
        }
      ]
    },
    {
      "name": "eq_presets",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"eq_presets\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"builtin\" INTEGER NOT NULL DEFAULT 0 CHECK (\"builtin\" IN (0, 1)), \"gains_json\" TEXT NOT NULL, \"preamp\" REAL NOT NULL DEFAULT 0.0);"
        }
      ]
    },
    {
      "name": "playback_state",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"playback_state\" (\"id\" INTEGER NOT NULL DEFAULT 1, \"queue_json\" TEXT NOT NULL DEFAULT '[]', \"shuffled_json\" TEXT NOT NULL DEFAULT '[]', \"current_index\" INTEGER NOT NULL DEFAULT 0, \"position_ms\" INTEGER NOT NULL DEFAULT 0, \"loop_mode\" INTEGER NOT NULL DEFAULT 0, \"shuffle\" INTEGER NOT NULL DEFAULT 0 CHECK (\"shuffle\" IN (0, 1)), PRIMARY KEY (\"id\"), CHECK (id = 1));"
        }
      ]
    },
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
